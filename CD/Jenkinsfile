pipeline {
    agent any

    parameters {
        string(
            name: 'IMAGE_TAG',
            defaultValue: '',
            description: 'Docker image tag published by CI'
        )
    }

    environment {
        IMAGE_NAME = 'mshanturov/classic_developer_ml_cicle'

        ANSIBLE_VAULT_PASSWORD = credentials('ansible-vault-password')
        BOOTSTRAP_REDIS_PASSWORD = credentials('redis-password')

        BOOTSTRAP_KAFKA_BOOTSTRAP_SERVERS = 'kafka:9092'
        BOOTSTRAP_KAFKA_TOPIC = 'model-predictions'
        BOOTSTRAP_KAFKA_GROUP_ID = 'model-prediction-consumer'

        REDIS_KEY_PREFIX = 'lab4-cd'
    }

    options {
        timestamps()
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Validate image tag') {
            steps {
                script {
                    if (!params.IMAGE_TAG?.trim()) {
                        error(
                            'IMAGE_TAG is empty. ' +
                            'CD must be started by CI with a Docker image tag.'
                        )
                    }

                    echo "Deploying image: ${env.IMAGE_NAME}:${params.IMAGE_TAG}"
                }
            }
        }

        stage('Pull published image') {
            steps {
                sh """
                    docker pull ${env.IMAGE_NAME}:${params.IMAGE_TAG}
                    docker tag \
                        ${env.IMAGE_NAME}:${params.IMAGE_TAG} \
                        ${env.IMAGE_NAME}:latest
                """
            }
        }

        stage('Start infrastructure') {
            steps {
                sh '''
                    docker compose up -d vault-init kafka redis
                '''
            }
        }

        stage('Start application') {
            steps {
                sh '''
                    docker compose up -d --no-build web kafka-consumer
                '''
            }
        }

        stage('Seed Redis with inference requests') {
            steps {
                sh '''
                    docker compose exec -T web \
                        python3 src/seed_redis_data.py \
                        --input data/Test_Seeds_X.csv \
                        --limit 3 \
                        --prefix $REDIS_KEY_PREFIX
                '''
            }
        }

        stage('Run functional tests') {
            steps {
                sh '''
                    docker compose --profile cd run \
                        --rm \
                        --no-deps \
                        functional-tests
                '''
            }
        }

        stage('Collect logs') {
            steps {
                sh '''
                    docker compose logs > cd-functional-tests.log
                '''
            }
        }
    }

    post {
        always {
            sh '''
                docker compose logs > cd-functional-tests.log 2>&1 || true
            '''

            archiveArtifacts(
                artifacts: 'cd-functional-tests.log',
                allowEmptyArchive: true
            )

            sh '''
                docker compose down -v || true
            '''
        }
    }
}