pipeline {
    agent any

    parameters {
        string(name: 'IMAGE_TAG', defaultValue: 'latest', description: 'Docker Hub image tag produced by CI')
    }

    environment {
        APP_IMAGE = "mshanturov/classic_developer_ml_cicle:${params.IMAGE_TAG}"
        ANSIBLE_VAULT_PASSWORD = credentials('ansible-vault-password')
        BOOTSTRAP_REDIS_PASSWORD = credentials('redis-password')
        BOOTSTRAP_KAFKA_BOOTSTRAP_SERVERS = 'kafka:9092'
        BOOTSTRAP_KAFKA_TOPIC = 'model-predictions'
        BOOTSTRAP_KAFKA_GROUP_ID = 'model-prediction-consumer'
        REDIS_KEY_PREFIX = 'lab4-cd'
    }

    options {
        timestamps()
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Pull and run CI image') {
            steps {
                sh 'docker pull $APP_IMAGE'
                sh 'docker compose build vault-init'
                sh 'docker compose up -d --no-build vault-init kafka redis web kafka-consumer'
            }
        }

        stage('Seed Redis with inference requests') {
            steps {
                sh 'docker compose exec -T web python3 src/seed_redis_data.py --input data/Test_Seeds_X.csv --limit 3 --prefix $REDIS_KEY_PREFIX'
            }
        }

        stage('Run functional tests') {
            steps {
                sh 'docker compose --profile cd run --rm --no-build functional-tests'
            }
        }

        stage('Collect logs') {
            steps {
                sh 'docker compose logs > cd-functional-tests.log'
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'cd-functional-tests.log', allowEmptyArchive: true
            sh 'docker compose down -v || true'
        }
    }
}
