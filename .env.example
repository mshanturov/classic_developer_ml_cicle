# Copy to .env for docker-compose local run.
# These values initialize and unlock Ansible Vault.
ANSIBLE_VAULT_PASSWORD=change_me_vault_password
BOOTSTRAP_REDIS_PASSWORD=change_me_redis_password
BOOTSTRAP_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
BOOTSTRAP_KAFKA_TOPIC=model-predictions
BOOTSTRAP_KAFKA_GROUP_ID=model-prediction-consumer
REDIS_KEY_PREFIX=lab4
